{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "types": ["node"]
  },
  "include": ["server/src/**/*.ts", "tests/**/*.ts"]
}
